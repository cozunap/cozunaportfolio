// Cloudflare Visual Website Builder Environment
// See https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "visual-builder-api",
	"main": "workers/api/src/index.ts",
	"compatibility_date": "2026-09-20",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "visual-builder-db",
			"database_id": "2341fd8f-8026-4613-9a38-c2314560c993"
		}
	],
	"r2_buckets": [
		// { "binding": "MEDIA", "bucket_name": "builder-media" }
	],
	"durable_objects": {
		"bindings": [
			// { "name": "REALTIME_EDITOR", "class_name": "EditorCoordinator" }
		]
	}
}